{
  "name": "@genoffice/shell",
  "productName": "Apex Office",
  "version": "1.0.4",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bharadfi/apex_office_suite",
  "private": true,
  "description": "Apex Office: the all-in-one productivity suite for documents, spreadsheets, presentations, PDF, Markdown and HTML",
  "main": "out/main/index.js",
  "desktopName": "apexoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/docs": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/cli": "*",
    "@genoffice/i18n": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/sheets": "*",
    "@genoffice/slides": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@genoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.8.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.1",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "author": "Apex Office"
}
