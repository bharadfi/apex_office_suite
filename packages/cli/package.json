{
  "name": "@genoffice/cli",
  "version": "1.0.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "apexoffice: the Apex Office command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./args": "./src/args.ts",
    "./control-protocol": "./src/control-protocol.ts"
  },
  "bin": {
    "apexoffice": "./bin/apexoffice"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genoffice/doc2docx": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/hwp2docx": "*",
    "@genoffice/odf2ooxml": "*",
    "@genoffice/pdf2docx": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-ops": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/xlsx-gateway": "*",
    "@rhwp/core": "0.8.7",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pngjs": "^7.0.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
